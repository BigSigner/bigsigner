#!/usr/bin/env python3
"""Run a BigSigner emulator. Press r to restart it.

Usage: scripts/emulator [port]

The default port is 8766, separate from an emulator already on 8765.
Each restart is a new process, so seeds and wallets start empty.
"""

import os
import signal
import subprocess
import sys
import termios
import time
import tty
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
PYTHON = ROOT / ".venv" / "bin" / "python"


def parse_port(argv):
    if len(argv) > 2:
        raise SystemExit("Usage: scripts/emulator [port]")
    raw = argv[1] if len(argv) == 2 else os.environ.get("BIGSIGNER_PORT", "8766")
    if not raw.isdigit() or not 1 <= int(raw) <= 65535:
        raise SystemExit(f"Port must be a number from 1 to 65535, not {raw!r}.")
    return int(raw)


def listening_pids(port):
    result = subprocess.run(
        ["lsof", "-nP", f"-iTCP:{port}", "-sTCP:LISTEN", "-t"],
        capture_output=True,
        text=True,
        check=False,
    )
    return [int(line) for line in result.stdout.split() if line.isdigit()]


def stop(proc, port):
    if proc is not None and proc.poll() is None:
        try:
            os.killpg(proc.pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
        try:
            proc.wait(timeout=1)
        except subprocess.TimeoutExpired:
            try:
                os.killpg(proc.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            proc.wait()
    for pid in listening_pids(port):
        try:
            os.kill(pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
    deadline = time.monotonic() + 2
    while time.monotonic() < deadline:
        if not listening_pids(port):
            return
        time.sleep(0.05)
    raise SystemExit(f"Port {port} is still in use.")


def start(port):
    if not PYTHON.is_file():
        raise SystemExit(f"Missing {PYTHON}. Create the virtualenv first.")
    env = os.environ.copy()
    env["PYTHONPATH"] = str(ROOT / "src")
    env["PYTHONUNBUFFERED"] = "1"
    env["BIGSIGNER_EMULATOR"] = "1"
    env["BIGSIGNER_PORT"] = str(port)
    return subprocess.Popen(
        [str(PYTHON), "-m", "bigsigner"],
        cwd=ROOT,
        env=env,
        stdin=subprocess.DEVNULL,
        start_new_session=True,
    )


def wait_until_listening(proc, port):
    deadline = time.monotonic() + 5
    while time.monotonic() < deadline:
        if listening_pids(port):
            return
        if proc.poll() is not None:
            raise SystemExit(f"Emulator exited with status {proc.returncode} before it started listening.")
        time.sleep(0.05)
    raise SystemExit(f"Emulator did not start on port {port}.")


def launch(port):
    stop(None, port)
    proc = start(port)
    wait_until_listening(proc, port)
    return proc


def main():
    port = parse_port(sys.argv)
    print("Press r to restart with empty memory. Ctrl+C to stop.", flush=True)
    proc = launch(port)
    fd = sys.stdin.fileno()
    previous = termios.tcgetattr(fd) if sys.stdin.isatty() else None
    if previous is not None:
        tty.setcbreak(fd)
    try:
        while True:
            char = sys.stdin.read(1)
            if char == "" or char == "\x04":
                break
            if char == "r":
                print("Restarting.", flush=True)
                stop(proc, port)
                proc = launch(port)
    except KeyboardInterrupt:
        print(flush=True)
    finally:
        if previous is not None:
            termios.tcsetattr(fd, termios.TCSADRAIN, previous)
        stop(proc, port)


if __name__ == "__main__":
    main()
